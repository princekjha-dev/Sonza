<fav id="fast-rewind">
    <symbol fill="#FFFFFF"
            extend-bounds="10"
            viewBox="0 0 48 48">
        <path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/>
    </symbol>
    <animations>
        <!-- In and Out animation -->
        <animation affected-paths="*"
                   id="in"
                   use-object-anchor="true"
                   duration="0.3"
                   easing="cubic-bezier(.3,1.35,.75,1)">
            <keyframe time="0">
                <scale-x value="0" />
                <scale-y value="0" />
            </keyframe>
            <keyframe time="1">
                <scale-x value="1" />
                <scale-y value="1" />
            </keyframe>
        </animation>
        <animation affected-paths="*"
                   id="out"
                   use-object-anchor="true"
                   duration="0.2"
                   easing="cubic-bezier(.3,1.35,.75,1)">
            <keyframe time="0">
                <scale-x value="1" />
                <scale-y value="1" />
            </keyframe>
            <keyframe time="1">
                <scale-x value="0" />
                <scale-y value="0" />
            </keyframe>
        </animation>
    </animations>
</fav>